# Railway Postgres connection string. Leave unset locally to use the embedded dev database.
DATABASE_URL=

# Long random string used to sign session cookies (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Custom domains (optional). With both set, customers use APP_HOST and the platform console only
# answers on CONSOLE_HOST, e.g. APP_HOST=grow.lasanlabs.com and CONSOLE_HOST=ops.lasanlabs.com.
# Leave unset to serve everything on every address (local development, Vercel previews).
APP_HOST=
CONSOLE_HOST=

# Login for the restricted role lasan_grow_app (created by migration 0003), used for everything
# customers do so their requests never hold owner credentials. Set its password once with:
#   ALTER ROLE lasan_grow_app WITH LOGIN PASSWORD '<long random>';
# Leave unset locally: the owner connection then switches to that role per transaction.
DATABASE_APP_URL=
